Algoritmo "Problema_fatorial"

Var


   i, n, fat: inteiro




Inicio
   escreva("Digite o valor de N: ")
   LEIA(n)
   
   fat<- 1

   
   para i de n ate 1 passo -1 faca
        fat<- i*fat

   fimpara
   
   escreval("Fatorial = ", fat)
   


















Fimalgoritmo