Algoritmo "PROBLEMA senha_fica"

Var

   senha: inteiro

Inicio

   escreva("Digite a sua senha com 4 digitos: ")
   leia(senha)
   
   enquanto senha<> 2002 faca
      escreva("Senha Invalida! Tente novamente: ")
      leia(senha)
   fimenquanto
   
   escreval("acesso permitido!")



Fimalgoritmo
